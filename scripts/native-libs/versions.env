# Pinned upstream versions for scripts/native-libs. Sourced by bash, keep it plain KEY=VALUE.
#
# Version scheme
#   OpenCV      : upstream OpenCV version (4.13.0). The sources are the stripped "opencv-mobile"
#                 flavour (github.com/nihui/opencv-mobile), the same one the app already ships.
#   Tesseract   : upstream tesseract-ocr/tesseract tag (5.5.1).
#   Dependencies: leptonica / libpng / libjpeg-turbo versions are pinned *per tesseract version*
#                 with TESSERACT_<ver>_<DEP> (dots become underscores), so one tesseract version
#                 always builds against the same dependency set.
#   SHA256_*    : optional source archive checksums. When present the download is verified,
#                 when absent the script warns and prints the checksum to pin.

OPENCV_DEFAULT_VERSION=4.13.0
TESSERACT_DEFAULT_VERSION=5.5.1

# Android NDK installed by the workflow (ANDROID_NDK_HOME must point to it for local builds)
NATIVE_LIBS_NDK_VERSION=27.3.13750724
# Android ABIs built by default (override with NATIVE_LIBS_ANDROID_ABIS="arm64-v8a armeabi-v7a x86 x86_64")
NATIVE_LIBS_ANDROID_ABIS_DEFAULT="arm64-v8a armeabi-v7a x86_64"
# Android API level the static libs are compiled for (minSdkVersion of plugin-nativeprocessor)
NATIVE_LIBS_ANDROID_API=24
# Apple deployment targets (App_Resources/documentscanner/iOS/build.xcconfig: IPHONEOS_DEPLOYMENT_TARGET = 16.0)
NATIVE_LIBS_IOS_MIN=16.0
NATIVE_LIBS_CATALYST_MIN=16.0

# Deployment targets used when OpenCV is built from source (same values as opencv-mobile's own CI)
OPENCV_IOS_MIN=13.0
OPENCV_CATALYST_MIN=13.1

# ---- OpenCV (opencv-mobile release tag that carries OpenCV <version>) ----
OPENCV_MOBILE_TAG_4_12_0=v34
OPENCV_MOBILE_TAG_4_13_0=v35
OPENCV_MOBILE_TAG_4_14_0=v37

SHA256_opencv_mobile_4_13_0=9304482980b3e4ff1050a8527cdb5777fadf8c5dd9c1a8620170d23e252fb150
SHA256_opencv_mobile_4_13_0_android=f0e1a22fa9df0056ac89231e4e3604c01f2e40e69e0a0c244571c56d2bc85bfb
SHA256_opencv_mobile_4_13_0_ios=b16cf8ec2f3de04dcd24f426c85cea6ae120c91b36f961a45984fe7ccdb05ee1
SHA256_opencv_mobile_4_13_0_ios_simulator=cceaed5a83cfff8d4dbe5952d99ec4e0586af6e092c8fadf7d6c9b1d9fff003f
SHA256_opencv_mobile_4_13_0_mac_catalyst=71d851abaf61bc765063fb9883a997ee9fbe26aedf9287dfed584464703f4d34

# ---- Tesseract 5.5.1 and its dependency set ----
TESSERACT_5_5_1_LEPTONICA=1.85.0
TESSERACT_5_5_1_LIBPNG=1.6.48
TESSERACT_5_5_1_LIBJPEG_TURBO=3.1.4.1

SHA256_tesseract_5_5_1=a7a3f2a7420cb6a6a94d80c24163e183cf1d2f1bed2df3bbc397c81808a57237
SHA256_leptonica_1_85_0=c01376bce0379d4ea4bc2ec5d5cbddaa49e2f06f88242619ab8c059e21adf233
SHA256_libpng_1_6_48=b17e99026055727e8cba99160c3a9a7f9af788e9f786daeadded5a42243f1dd0
SHA256_libjpeg_turbo_3_1_4_1=a7da42b640377c2a9a9665e2c4b0ea60cd5599afb48c2521e6df0c9dc9d15a25
